---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Products from '@components/Products.astro';
import Podcast from '@components/Podcast.astro';
import Workshops from '@components/Workshops.astro';
import Newsletter from '@components/Newsletter.astro';
---

<BaseLayout>
  <!-- Interactive Hero Section -->
  <Hero />

  <!-- The 6 Initiatives Section -->
  <Products />

  <!-- Newsletter Section -->
  <Newsletter />

  <!-- Podcast Section -->
  <Podcast />

  <!-- Workshops Section -->
  <Workshops />

  <!-- About Segment -->
  <section id="about" class="about-section">
    <div class="container about-grid">
      <div class="about-header">
        <span class="section-tag">// OUR MISSION</span>
        <h2 class="section-title">Elevating the Core Layer</h2>
      </div>
      <div class="about-body">
        <p>
          theinfra was founded to address the lack of specialized, high-signal media channels dedicated to infrastructure and systems engineering in emerging markets. We believe that shipping robust, cost-effective infrastructure requires engineering discipline and deep architectural understanding.
        </p>
        <p>
          Through our virtual conferences, technical newsletters, raw audio broadcasts, and structured survey research, we build a community that shares real production telemetry, post-mortems, and performance benchmarks without the marketing hype.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-section {
    padding: var(--space-xxl) 0;
    border-top: 1px solid var(--border-color);
    background-color: rgba(6, 22, 16, 0.1);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .about-body p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: var(--space-md);
    color: var(--text-secondary);
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
