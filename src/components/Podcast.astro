---
import { getCollection } from 'astro:content';

let episodes = [];
try {
  episodes = await getCollection('podcast');
} catch (e) {
  // Collection might not be configured yet
}

const recentEpisodes = episodes
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

// Fallback mock episodes if none found in collection
const mockEpisodes = [
  {
    id: "designing-raft-logs-go",
    data: {
      title: "Designing Distributed Raft Consensus Logs in Go",
      episodeNumber: "01",
      duration: "48:15",
      description: "A deep dive into building log replication systems, handling consensus edge cases, and optimizing write throughput with batching.",
      date: "2026-05-15"
    }
  },
  {
    id: "linux-kernel-ebpf-networking",
    data: {
      title: "Kernel-level Packet Filtering with eBPF and XDP",
      episodeNumber: "02",
      duration: "56:32",
      description: "Exploring eBPF bytecode compilation, loading programs into network interface cards, and filtering packets at the driver level.",
      date: "2026-05-28"
    }
  }
];

const displayEpisodes = recentEpisodes.length > 0 ? recentEpisodes : mockEpisodes;
---

<section id="podcast" class="podcast-section">
  <div class="container podcast-grid-layout">
    <div class="podcast-info">
      <span class="section-tag">// SOUNDWAVE STREAM</span>
      <h2 class="section-title">Runtime <span class="text-glow">Podcast</span></h2>
      <p class="section-desc">
        Tune in to weekly high-fidelity dialogues with developers and architects operating systems under load. No corporate scripts, no superficial overviews. Just production war stories.
      </p>

      <div class="podcast-platforms card">
        <h4 class="platform-title">Available Directories</h4>
        <div class="platform-grid">
          <a href="#" class="platform-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            Spotify
          </a>
          <a href="#" class="platform-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
            Apple Podcasts
          </a>
          <a href="#" class="platform-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v8"></path><path d="M8 12h8"></path></svg>
            Pocket Casts
          </a>
          <a href="#" class="platform-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
            RSS Feed
          </a>
        </div>
      </div>
    </div>

    <div class="podcast-episodes">
      <h3 class="episodes-header-title">Recent Broadcasts</h3>
      <div class="episode-list">
        {displayEpisodes.map((ep) => (
          <article class="episode-card card">
            <div class="ep-meta">
              <span class="ep-num">EP #{ep.data.episodeNumber}</span>
              <span class="ep-duration">• {ep.data.duration}</span>
            </div>
            <h4 class="ep-title">
              <a href={`/podcast/${ep.id}`}>{ep.data.title}</a>
            </h4>
            <p class="ep-desc">{ep.data.description}</p>
            <div class="ep-player-mock">
              <button class="mock-play-btn" aria-label="Play Episode">
                <svg xmlns="http://www.w3.org/2000/svg" class="play-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              </button>
              <div class="mock-progress-bar">
                <div class="mock-progress-fill" style="width: 0%"></div>
              </div>
              <span class="mock-time">00:00</span>
            </div>
          </article>
        ))}
      </div>
      <div class="more-episodes-link">
        <a href="/podcast" class="btn btn-more">Browse All Episodes</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Add audio player logic to the mock play buttons
  const playButtons = document.querySelectorAll('.mock-play-btn');
  
  playButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.episode-card');
      if (!card) return;
      
      const playIcon = btn.querySelector('.play-svg');
      const progressFill = card.querySelector('.mock-progress-fill') as HTMLElement;
      const timeDisplay = card.querySelector('.mock-time');

      btn.classList.toggle('playing');

      if (btn.classList.contains('playing')) {
        if (playIcon) {
          playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>';
        }
        
        // Simple mock progress bar tick
        let pct = 0;
        const tick = setInterval(() => {
          if (!btn.classList.contains('playing')) {
            clearInterval(tick);
            return;
          }
          pct += 0.5;
          if (pct > 100) pct = 0;
          if (progressFill) progressFill.style.width = `${pct}%`;
          
          // Calculate dummy time
          const seconds = Math.floor((pct / 100) * 120);
          const minsStr = Math.floor(seconds / 60).toString().padStart(2, '0');
          const secsStr = (seconds % 60).toString().padStart(2, '0');
          if (timeDisplay) timeDisplay.textContent = `${minsStr}:${secsStr}`;
        }, 100);
      } else {
        if (playIcon) {
          playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"></polygon>';
        }
      }
    });
  });
</script>

<style>
  .podcast-section {
    padding: var(--space-xxl) 0;
    border-top: 1px solid var(--border-color);
    background-color: rgba(6, 22, 16, 0.2);
  }

  .podcast-grid-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-xxl);
    align-items: flex-start;
  }

  .podcast-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .podcast-platforms {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: var(--space-lg);
  }

  .platform-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: var(--space-md);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .platform-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.6rem var(--space-md);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
    transition: all var(--transition-fast);
  }

  .platform-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: rgba(127, 255, 197, 0.05);
  }

  .episodes-header-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: var(--space-lg);
    border-left: 2px solid var(--accent);
    padding-left: var(--space-sm);
  }

  .episode-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .episode-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
  }

  .ep-meta {
    display: flex;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: var(--space-xs);
  }

  .ep-num {
    color: var(--accent);
    font-weight: 500;
  }

  .ep-title {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }

  .ep-title a {
    color: var(--text-primary);
  }

  .ep-title a:hover {
    color: var(--accent);
  }

  .ep-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    line-height: 1.5;
  }

  /* Mock Audio Player widget styling */
  .ep-player-mock {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background-color: var(--bg-surface-elevated);
    padding: 0.6rem 1rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  .mock-play-btn {
    background: var(--accent);
    color: var(--bg-base);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .mock-play-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.4);
  }

  .mock-progress-bar {
    flex-grow: 1;
    height: 4px;
    background-color: var(--border-color);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .mock-progress-fill {
    height: 100%;
    background-color: var(--accent);
    position: absolute;
    top: 0;
    left: 0;
    transition: width 0.1s linear;
  }

  .mock-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    min-width: 38px;
    text-align: right;
  }

  .more-episodes-link {
    margin-top: var(--space-lg);
    display: flex;
    justify-content: flex-end;
  }

  .btn-more {
    font-size: 0.8rem;
    padding: 0.5rem 1.25rem;
  }

  /* Responsive Styling */
  @media (max-width: 900px) {
    .podcast-grid-layout {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 480px) {
    .platform-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
